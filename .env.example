# Server-only environment variables (do not use VITE_ prefix for secrets)
APP_CONTACT_URL=https://github.com/mesavin13-droid
# Authorized participant/integrator key for the Russian National Catalog (optional)
NATIONAL_CATALOG_API_KEY=
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1-mini

# Dedicated Supabase project; backend-only. Never use VITE_ prefix or commit keys.
# Optional RU EAN-online API token issued by provider (server only)
EAN_ONLINE_API_TOKEN=
# Optional paid licensed Russian KБЖУ provider
FOODBASE_API_KEY=
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Preferred: modern backend-only key (sb_secret_...)
SUPABASE_SECRET_KEY=
# Alternative: legacy service_role JWT; do not configure both.
SUPABASE_SERVICE_ROLE_KEY=
